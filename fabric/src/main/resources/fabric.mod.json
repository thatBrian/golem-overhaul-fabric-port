{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Golem Overhaul adds 9 new golem types, all with their own unique mechanics! Unofficial Fabric port for Minecraft 26.1.x — original mod by Bonsai Studios.",
  "authors": [
    "Alex Nijjar",
    "Joosh",
    "3xpl01t"
  ],
  "contributors": [
    "thatBrian (unofficial 26.1.x Fabric port)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/golem-overhaul",
    "sources": "https://github.com/thatBrian/golem-overhaul-fabric-port",
    "issues": "https://github.com/thatBrian/golem-overhaul-fabric-port/issues"
  },
  "license": "ARR",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "tech.alexnijjar.golemoverhaul.fabric.GolemOverhaulFabric"
    ]
  },
  "mixins": [
    "golemoverhaul.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "${fabric_api_version_range}",
    "architectury": ">=${architectury_api_version}",
    "resourcefullib": ">=${resourcefullib_version}",
    "resourcefulconfig": ">=${resourcefulconfig_version}",
    "geckolib": ">=${geckolib_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "golemoverhaul:upstream": "https://github.com/bonsaistudi0s/Golem-Overhaul (1.21.1/main, tag 1.1.1)"
  }
}
